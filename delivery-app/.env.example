# ==============================================================================
# AtlasBasket Delivery Web App — Environment Variables Template
# ==============================================================================

# NextAuth configuration
# Production: https://delivery.atlasbasket.com
# Local: http://localhost:8004
NEXTAUTH_URL=https://delivery.atlasbasket.com
NEXTAUTH_SECRET=your_nextauth_secret_here

# Backend API Configuration
BACKEND_API_URL=https://delivery-api.atlasbasket.com
NEXT_PUBLIC_API_URL=https://delivery-api.atlasbasket.com

# Persistent WebSocket URL for Rider Dispatch Support Chat
NEXT_PUBLIC_WS_URL=wss://delivery-api.atlasbasket.com

# App Metadata
NEXT_PUBLIC_APP_NAME="AtlasBasket Delivery"

# Google Maps API (Directions, Geocoding, Distance Matrix)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google OAuth Credentials (for Rider Google Login)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
