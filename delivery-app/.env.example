# ==============================================================================
# AtlasBasket Delivery — Environment Variables Template
# Copy this file to .env and fill in the required credentials.
# ==============================================================================

# Backend API Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000

# Persistent WebSocket URL for Rider Dispatch Support Chat
NEXT_PUBLIC_WS_URL=ws://localhost:5000

# App Metadata (Districts are fetched dynamically from database as enabled by Admin)
NEXT_PUBLIC_APP_NAME="AtlasBasket Delivery"

# Google Maps API (Directions, Geocoding, Distance Matrix)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google OAuth Credentials (for Rider Google Login)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# NextAuth / Session Secret (for Rider Google OAuth & Session Management)
NEXTAUTH_SECRET=your_nextauth_secret_here
# Frontend app URL where NextAuth is running (e.g. http://localhost:8004 for local dev)
NEXTAUTH_URL=http://localhost:8004
