# ==============================================================================
# AtlasBasket Delivery — Environment Variables Template
# Copy this file to .env and fill in the required credentials.
# ==============================================================================

# Backend API Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000

# Persistent WebSocket URL for Rider Dispatch Support Chat
NEXT_PUBLIC_WS_URL=ws://localhost:5000

# App Metadata
NEXT_PUBLIC_APP_NAME="AtlasBasket Delivery"
NEXT_PUBLIC_DEFAULT_CITY="Mysuru"

# Google Maps API (Directions, Geocoding, Distance Matrix)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google OAuth Credentials (for Rider Google Login)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# NextAuth / Session Secret (if using NextAuth)
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000
