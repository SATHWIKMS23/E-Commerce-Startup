# Public backend API origin (do not include /api/delivery).
EXPO_PUBLIC_API_URL=https://your-delivery-api.example.com

# Backend dispatch-support WebSocket origin.
EXPO_PUBLIC_WS_URL=wss://your-delivery-api.example.com

# Google OAuth web client ID; the backend verifies the returned ID token.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Optional client-side Google Maps key for map features.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
