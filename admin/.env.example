# =============================================================================
# AtlasBasket Admin Web App Environment Variables Example
# =============================================================================

# NextAuth configuration
# Production: https://e-commerce-startup-admin.vercel.app
# Local: http://localhost:8001
NEXTAUTH_URL=https://e-commerce-startup-admin.vercel.app
NEXTAUTH_SECRET=your_nextauth_secret_here

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Backend Admin API base URL (server-side proxy via Next.js rewrites)
BACKEND_API_URL=https://admin-api.atlasbasket.com
ADMIN_BACKEND_API_URL=https://admin-api.atlasbasket.com
STORAGE_BACKEND_API_URL=https://admin-api.atlasbasket.com
