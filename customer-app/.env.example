# =============================================================================
# AtlasBasket Customer Web App Environment Variables Example
# =============================================================================

# NextAuth configuration
# Production: https://atlasbasket.com
# Local: http://localhost:3000
NEXTAUTH_URL=https://atlasbasket.com
NEXTAUTH_SECRET=your_nextauth_secret_here

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Backend Customer API base URL (server-side proxy via Next.js rewrites)
BACKEND_API_URL=https://api.atlasbasket.com

# Razorpay payment key
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
