model Coupon {
  id               String             @id @default(cuid())
  code             String             @unique @db.VarChar(50)
  description      String?
  discountType     CouponDiscountType
  discountValue    Decimal            @db.Decimal(12, 2)
  minOrderAmount   Decimal?           @db.Decimal(12, 2)
  maxDiscount      Decimal?           @db.Decimal(12, 2)
  usageLimit       Int?
  usageCount       Int                @default(0)
  perCustomerLimit Int                @default(1)
  sellerId         String?
  isActive         Boolean            @default(true)
  startsAt         DateTime?
  expiresAt        DateTime?
  createdByAdminId String?            @db.VarChar(30)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  usages           CouponUsage[]
  createdByAdmin   Admin?             @relation("CouponCreatedBy", fields: [createdByAdminId], references: [id])
  orders           Order[]

  @@index([code])
  @@index([isActive])
  @@index([sellerId])
  @@index([expiresAt])
  @@map("coupons")
}

model CouponUsage {
  id              String   @id @default(cuid())
  couponId        String
  customerId      String
  orderId         String   @unique
  discountApplied Decimal  @db.Decimal(12, 2)
  usedAt          DateTime @default(now())
  coupon          Coupon   @relation(fields: [couponId], references: [id])
  customer        Customer @relation(fields: [customerId], references: [id])
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([customerId])
  @@index([usedAt])
  @@map("coupon_usages")
}
