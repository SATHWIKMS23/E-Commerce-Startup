model CustomerCaseReport {
  id              String                @id @default(cuid())
  reportNumber    String                @unique @db.VarChar(50)
  customerId      String
  targetType      ReportTargetType      @default(SELLER)
  targetId        String                @db.VarChar(50)
  category        String                @db.VarChar(100)
  reason          String
  description     String
  attachments     String[]              @default([])
  status          CaseReportStatus      @default(PENDING)
  priority        SupportTicketPriority @default(MEDIUM)
  assignedAdminId String?               @db.VarChar(40)
  resolution      String?
  internalNotes   String?
  receivedAt      DateTime              @default(now())
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  assignedAdmin   Admin?                @relation("CaseReportAssignedAdmin", fields: [assignedAdminId], references: [id])
  customer        Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  timeline        ReportTimelineEvent[]

  @@index([customerId])
  @@index([targetType, targetId])
  @@index([status])
  @@index([priority])
  @@index([assignedAdminId])
  @@index([receivedAt])
  @@map("customer_case_reports")
}

model ReportTimelineEvent {
  id        String             @id @default(cuid())
  reportId  String
  actorType String             @db.VarChar(20)
  actorId   String             @db.VarChar(40)
  eventType String             @db.VarChar(50)
  note      String?
  metadata  Json?
  createdAt DateTime           @default(now())
  report    CustomerCaseReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([createdAt])
  @@map("report_timeline_events")
}

model PostmortemReport {
  id                  String           @id @default(cuid())
  reference           String           @unique @db.VarChar(50)
  title               String           @db.VarChar(255)
  summary             String
  severity            String           @default("SEV2") @db.VarChar(20)
  relatedType         String?          @db.VarChar(50)
  relatedId           String?          @db.VarChar(50)
  startTime           DateTime
  detectionTime       DateTime
  resolutionTime      DateTime?
  impact              String
  timeline            Json
  rootCause           String
  contributingFactors String
  resolution          String
  correctiveActions   Json
  preventiveActions   String
  responsibleOwner    String           @db.VarChar(120)
  reviewStatus        PostmortemStatus @default(DRAFT)
  approvedByAdminId   String?          @db.VarChar(40)
  createdByAdminId    String?          @db.VarChar(40)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  approvedByAdmin     Admin?           @relation("PostmortemApprovedBy", fields: [approvedByAdminId], references: [id])
  createdByAdmin      Admin?           @relation("PostmortemCreatedBy", fields: [createdByAdminId], references: [id])

  @@index([reviewStatus])
  @@index([severity])
  @@index([startTime])
  @@map("postmortem_reports")
}
