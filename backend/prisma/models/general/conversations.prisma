model Conversation {
  id                String                    @id @default(cuid())
  type              ConversationType          @default(CUSTOMER_ADMIN)
  customerId        String?
  sellerId          String?
  deliveryPartnerId String?
  subject           String?                   @db.VarChar(255)
  status            ConversationStatus        @default(OPEN)
  priority          SupportTicketPriority     @default(MEDIUM)
  assignedAdminId   String?                   @db.VarChar(40)
  relatedEntityType String?                   @db.VarChar(50)
  relatedEntityId   String?                   @db.VarChar(50)
  internalNotes     String?
  lastMessageAt     DateTime                  @default(now())
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  messages          ConversationMessage[]
  readReceipts      ConversationReadReceipt[]
  assignedAdmin     Admin?                    @relation("ConversationAssignedAdmin", fields: [assignedAdminId], references: [id])
  customer          Customer?                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
  seller            Seller?                   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  deliveryPartner   DeliveryPartner?          @relation(fields: [deliveryPartnerId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([customerId])
  @@index([sellerId])
  @@index([deliveryPartnerId])
  @@index([status])
  @@index([priority])
  @@index([assignedAdminId])
  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationMessage {
  id              String            @id @default(cuid())
  conversationId  String
  senderType      MessageSenderType @default(CUSTOMER)
  senderId        String            @db.VarChar(50)
  senderName      String?           @db.VarChar(120)
  message         String
  attachments     String[]          @default([])
  clientMessageId String?           @db.VarChar(80)
  isInternal      Boolean           @default(false)
  readAt          DateTime?
  createdAt       DateTime          @default(now())
  conversation    Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@index([senderType, senderId])
  @@index([clientMessageId])
  @@map("conversation_messages")
}

model ConversationReadReceipt {
  id             String       @id @default(cuid())
  conversationId String
  readerType     String       @db.VarChar(20)
  readerId       String       @db.VarChar(50)
  lastReadAt     DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, readerType, readerId])
  @@index([conversationId])
  @@map("conversation_read_receipts")
}
