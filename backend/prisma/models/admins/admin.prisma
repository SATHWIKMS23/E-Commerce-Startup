model Admin {
  id                         String                    @id @default(cuid())
  email                      String                    @unique @db.VarChar(320)
  passwordHash               String?                   @db.VarChar(255)
  firstName                  String                    @db.VarChar(100)
  lastName                   String                    @db.VarChar(100)
  phone                      String?                   @db.VarChar(20)
  avatarUrl                  String?                   @db.VarChar(2048)
  isActive                   Boolean                   @default(true)
  isSuperAdmin               Boolean                   @default(false)
  lastLoginAt                DateTime?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  authProvider               AuthProvider              @default(EMAIL)
  googleId                   String?                   @db.VarChar(255)
  role                       String                    @default("ADMIN")
  roleId                     String?                   @db.VarChar(30)
  avatarPublicId             String?                   @db.VarChar(255)
  actions                    AdminAction[]
  refreshTokens              AdminRefreshToken[]
  adminRole                  AdminRole?                @relation(fields: [roleId], references: [id])
  publishedStatements        CommissionStatement[]     @relation("StatementPublishedBy")
  createdGuidelines          CommunityGuideline[]      @relation("GuidelineCreatedBy")
  publishedGuidelines        CommunityGuideline[]      @relation("GuidelinePublishedBy")
  assignedConversations      Conversation[]            @relation("ConversationAssignedAdmin")
  createdCoupons             Coupon[]                  @relation("CouponCreatedBy")
  assignedCaseReports        CustomerCaseReport[]      @relation("CaseReportAssignedAdmin")
  createdDeliveryPartners    DeliveryPartner[]         @relation("DeliveryPartnerCreatedBy")
  createdPolicies            MarketplacePolicyNotice[] @relation("PolicyCreatedBy")
  publishedPolicies          MarketplacePolicyNotice[] @relation("PolicyPublishedBy")
  notifications              Notification[]
  reviewedPackingFeeRequests PackingFeeRequest[]       @relation("PackingFeeRequestReviewedBy")
  approvedPostmortems        PostmortemReport[]        @relation("PostmortemApprovedBy")
  createdPostmortems         PostmortemReport[]        @relation("PostmortemCreatedBy")
  reviewedProductReports     ProductReport[]           @relation("ProductReportReviewedBy")
  reviewedReturns            ReturnRequest[]           @relation("ReturnReviewedBy")
  assignedAppeals            SellerAppeal[]            @relation("AppealAssignedAdmin")
  decidedAppeals             SellerAppeal[]            @relation("AppealDecidedAdmin")
  issuedStrikes              SellerStrike[]
  issuedSuspensions          SellerSuspension[]        @relation("SuspensionIssuedBy")
  reinstatedSuspensions      SellerSuspension[]        @relation("SuspensionReinstatedBy")
  reviewedVerifications      SellerVerification[]      @relation("SellerVerificationReviewedBy")
  approvedSellers            Seller[]                  @relation("SellerApprovedBy")
  issuedShopAgreements       ShopAgreement[]           @relation("ShopAgreementIssuedBy")
  reviewedShopApprovals      ShopApprovalRequest[]     @relation("ShopApprovalReviewedBy")
  reviewedShops              Shop[]                    @relation("ShopReviewedBy")
  assignedSupportTickets     SupportTicket[]           @relation("SupportTicketAssignedTo")

  @@index([email])
  @@index([isActive])
  @@index([roleId])
  @@map("admins")
}
