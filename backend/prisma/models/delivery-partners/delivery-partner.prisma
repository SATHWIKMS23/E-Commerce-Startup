model DeliveryPartner {
  id                       String                        @id @default(cuid())
  email                    String                        @unique @db.VarChar(320)
  passwordHash             String                        @db.VarChar(255)
  firstName                String                        @db.VarChar(100)
  lastName                 String                        @db.VarChar(100)
  phone                    String                        @unique @db.VarChar(20)
  avatarUrl                String?                       @db.VarChar(2048)
  status                   DeliveryPartnerStatus         @default(ACTIVE)
  verificationStatus       RiderVerificationStatus       @default(PENDING)
  rejectionReason          String?
  dateOfBirth              DateTime?
  emergencyContactName     String?                       @db.VarChar(100)
  emergencyContactPhone    String?                       @db.VarChar(20)
  residentialAddress       String?                       @db.VarChar(500)
  city                     String?                       @default("Mysuru") @db.VarChar(100)
  vehicleType              String?                       @db.VarChar(50)
  vehicleNumber            String?                       @db.VarChar(30)
  licenseNumber            String?                       @db.VarChar(50)
  rcNumber                 String?                       @db.VarChar(50)
  insuranceNumber          String?                       @db.VarChar(50)
  vehiclePhotoUrl          String?                       @db.VarChar(2048)
  bankAccountName          String?                       @db.VarChar(100)
  bankAccountNumber        String?                       @db.VarChar(50)
  bankIfsc                 String?                       @db.VarChar(20)
  upiId                    String?                       @db.VarChar(100)
  aadhaarNumberMasked      String?                       @db.VarChar(20)
  aadhaarDocUrl            String?                       @db.VarChar(2048)
  aadhaarDocKey            String?                       @db.VarChar(255)
  aadhaarVerified          Boolean                       @default(false)
  aadhaarDeletedAt         DateTime?
  isAvailable              Boolean                       @default(false)
  currentLat               Decimal?                      @db.Decimal(10, 8)
  currentLng               Decimal?                      @db.Decimal(11, 8)
  lastLocationUpdatedAt    DateTime?
  lastLoginAt              DateTime?
  rating                   Float                         @default(5.0)
  totalRatings             Int                           @default(0)
  totalDeliveriesCount     Int                           @default(0)
  completedDeliveriesCount Int                           @default(0)
  cancelledDeliveriesCount Int                           @default(0)
  strikeCount              Int                           @default(0)
  createdByAdminId         String?                       @db.VarChar(30)
  verifiedByAdminId        String?                       @db.VarChar(30)
  approvedAt               DateTime?
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt
  deliveries               Delivery[]
  addresses                DeliveryPartnerAddress[]
  refreshTokens            DeliveryPartnerRefreshToken[]
  createdByAdmin           Admin?                        @relation("DeliveryPartnerCreatedBy", fields: [createdByAdminId], references: [id])
  deliveryProofs           DeliveryProof[]
  notifications            Notification[]
  conversations            Conversation[]
  assignments              DeliveryAssignment[]
  ratings                  DeliveryRating[]
  incidents                DeliveryIncident[]
  strikes                  RiderStrike[]
  payouts                  RiderPayout[]
  documents                RiderDocument[]

  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([verificationStatus])
  @@index([isAvailable])
  @@index([createdByAdminId])
  @@map("delivery_partners")
}
