model Wishlist {
  id         String         @id @default(cuid())
  customerId String         @unique
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  items      WishlistItem[]
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("wishlists")
}
