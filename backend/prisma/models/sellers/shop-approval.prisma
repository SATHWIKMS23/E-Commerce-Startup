model ShopApprovalRequest {
  id                String                    @id @default(cuid())
  shopId            String
  sellerId          String
  status            ShopApprovalRequestStatus @default(PENDING_REVIEW)
  notes             String?
  rejectionReason   String?
  submittedAt       DateTime                  @default(now())
  reviewedAt        DateTime?
  reviewedByAdminId String?                   @db.VarChar(30)
  approvedAt        DateTime?
  rejectedAt        DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  agreements        ShopAgreement[]
  reviewedByAdmin   Admin?                    @relation("ShopApprovalReviewedBy", fields: [reviewedByAdminId], references: [id])
  seller            Seller                    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  shop              Shop                      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([sellerId])
  @@index([status])
  @@index([submittedAt])
  @@map("shop_approval_requests")
}

model ShopAgreement {
  id                    String              @id @default(cuid())
  shopId                String
  sellerId              String
  approvalRequestId     String
  version               Int                 @default(1)
  title                 String              @db.VarChar(255)
  templateId            String?             @db.VarChar(100)
  templateVersion       String?             @db.VarChar(50)
  content               String
  documentHash          String?             @db.VarChar(128)
  commissionPercentage  Float               @default(10.0)
  commissionNotes       String?
  customerDeliveryShare Int                 @default(75)
  sellerDeliveryShare   Int                 @default(25)
  deliveryObligations   String?
  sellerObligations     String?
  customTerms           Json?
  status                ShopAgreementStatus @default(ISSUED)
  issuedByAdminId       String?             @db.VarChar(30)
  issuedAt              DateTime            @default(now())
  effectiveDate         DateTime            @default(now())
  acceptedAt            DateTime?
  acceptedLegalName     String?             @db.VarChar(200)
  acceptanceMethod      String?             @default("ELECTRONIC_SIGNATURE") @db.VarChar(100)
  ipAddress             String?             @db.VarChar(45)
  userAgent             String?             @db.VarChar(512)
  signatureImageUrl     String?             @db.VarChar(2048)
  declinedAt            DateTime?
  declinedReason        String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  approvalRequest       ShopApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  issuedByAdmin         Admin?              @relation("ShopAgreementIssuedBy", fields: [issuedByAdminId], references: [id])
  seller                Seller              @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  shop                  Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([sellerId])
  @@index([approvalRequestId])
  @@index([status])
  @@index([issuedAt])
  @@map("shop_agreements")
}

enum ShopApprovalRequestStatus {
  PENDING_REVIEW
  AGREEMENT_ISSUED
  AGREEMENT_ACCEPTED
  AGREEMENT_DECLINED
  AWAITING_FINAL_APPROVAL
  APPROVED
  REJECTED
}

enum ShopAgreementStatus {
  DRAFT
  ISSUED
  ACCEPTED
  DECLINED
  SUPERSEDED
  EXPIRED
}
