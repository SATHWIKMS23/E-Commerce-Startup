model PackingFeeRequest {
  id                String                  @id @default(cuid())
  shopId            String
  status            PackingFeeRequestStatus @default(PENDING)
  reason            String
  supportingNotes   String?
  rejectionReason   String?
  reviewedByAdminId String?                 @db.VarChar(30)
  reviewedAt        DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  requestedMaxFee   Decimal?                @db.Decimal(10, 2)
  approvedMaxFee    Decimal?                @db.Decimal(10, 2)
  reviewedByAdmin   Admin?                  @relation("PackingFeeRequestReviewedBy", fields: [reviewedByAdminId], references: [id])
  shop              Shop                    @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([status])
  @@map("packing_fee_requests")
}
