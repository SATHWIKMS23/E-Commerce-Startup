model SellerPayout {
  id              String             @id @default(cuid())
  sellerId        String
  sellerOrderId   String             @unique
  bankAccountId   String?
  amount          Decimal            @db.Decimal(12, 2)
  platformFee     Decimal            @db.Decimal(12, 2)
  currency        String             @default("INR") @db.VarChar(3)
  status          PayoutStatus       @default(PENDING)
  gatewayPayoutId String?            @unique @db.VarChar(255)
  processedAt     DateTime?
  failedAt        DateTime?
  failureReason   String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  bankAccount     SellerBankAccount? @relation(fields: [bankAccountId], references: [id])
  seller          Seller             @relation(fields: [sellerId], references: [id])
  sellerOrder     SellerOrder        @relation(fields: [sellerOrderId], references: [id])

  @@index([sellerId])
  @@index([status])
  @@index([createdAt])
  @@index([sellerId, status])
  @@map("seller_payouts")
}
