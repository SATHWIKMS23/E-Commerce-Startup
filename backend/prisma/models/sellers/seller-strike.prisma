model SellerStrike {
  id               String            @id @default(cuid())
  sellerId         String
  adminId          String
  severity         StrikeSeverity    @default(WARNING)
  reason           String
  description      String?
  isActive         Boolean           @default(true)
  expiresAt        DateTime?
  issuedAt         DateTime          @default(now())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  evidenceUrls     String[]          @default([])
  guidelineClause  String?           @db.VarChar(100)
  guidelineVersion String?           @db.VarChar(50)
  reference        String?           @unique @db.VarChar(40)
  relatedReportId  String?           @db.VarChar(40)
  status           EnforcementStatus @default(ISSUED)
  type             EnforcementType   @default(STRIKE)
  appeal           SellerAppeal?
  admin            Admin             @relation(fields: [adminId], references: [id])
  seller           Seller            @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([adminId])
  @@index([type])
  @@index([status])
  @@index([isActive])
  @@index([issuedAt])
  @@index([sellerId, type, status])
  @@map("seller_strikes")
}

model SellerSuspension {
  id                  String         @id @default(cuid())
  sellerId            String
  type                SuspensionType @default(THREE_STRIKES)
  reason              String
  suspendedAt         DateTime       @default(now())
  reinstatedAt        DateTime?
  reinstatementReason String?
  adminId             String?
  reinstatedByAdminId String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  admin               Admin?         @relation("SuspensionIssuedBy", fields: [adminId], references: [id])
  reinstatedByAdmin   Admin?         @relation("SuspensionReinstatedBy", fields: [reinstatedByAdminId], references: [id])
  seller              Seller         @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([type])
  @@index([suspendedAt])
  @@map("seller_suspensions")
}

model SellerAppeal {
  id                String        @id @default(cuid())
  reference         String        @unique @db.VarChar(40)
  sellerId          String
  enforcementId     String        @unique
  status            AppealStatus  @default(PENDING)
  sellerExplanation String
  sellerAttachments String[]      @default([])
  orderId           String?       @db.VarChar(40)
  reportId          String?       @db.VarChar(40)
  deadline          DateTime?
  assignedAdminId   String?       @db.VarChar(40)
  decisionReason    String?
  decidedByAdminId  String?       @db.VarChar(40)
  decidedAt         DateTime?
  internalNotes     String?
  submittedAt       DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  events            AppealEvent[]
  assignedAdmin     Admin?        @relation("AppealAssignedAdmin", fields: [assignedAdminId], references: [id])
  decidedByAdmin    Admin?        @relation("AppealDecidedAdmin", fields: [decidedByAdminId], references: [id])
  enforcement       SellerStrike  @relation(fields: [enforcementId], references: [id], onDelete: Cascade)
  seller            Seller        @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([status])
  @@index([submittedAt])
  @@index([assignedAdminId])
  @@map("seller_appeals")
}

model AppealEvent {
  id        String       @id @default(cuid())
  appealId  String
  actorType String       @db.VarChar(20)
  actorId   String       @db.VarChar(40)
  eventType String       @db.VarChar(50)
  note      String?
  metadata  Json?
  createdAt DateTime     @default(now())
  appeal    SellerAppeal @relation(fields: [appealId], references: [id], onDelete: Cascade)

  @@index([appealId])
  @@index([createdAt])
  @@map("appeal_events")
}
