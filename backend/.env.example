# =============================================================================
# AtlasBasket Backend Environment Variables Example
# =============================================================================

# Server Environment & Host
NODE_ENV=development
HOST=0.0.0.0
PORT=3001

# Service Ports (Individual Micro-APIs)
CUSTOMER_PORT=3001
SELLER_PORT=3002
ADMIN_PORT=3003
DELIVERY_PORT=3004
PAYMENT_PORT=3005

# =============================================================================
# Database Connection (PostgreSQL)
# =============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/marketplace?schema=public
DIRECT_URL=postgresql://user:password@localhost:5432/marketplace?schema=public

# =============================================================================
# Redis Connection (Shared Cache & Cross-Process WebSocket Pub/Sub)
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# Authentication & Security
# =============================================================================
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET_KEY=your_jwt_refresh_secret_key_here
CUSTOMER_SESSION_SECRET=your_customer_session_secret_hex
ADMIN_BOOTSTRAP_SECRET=your_admin_bootstrap_secret_at_least_32_chars
ALLOW_UNVERIFIED_GOOGLE=false

# =============================================================================
# Google OAuth Configuration (Web & Mobile Apps)
# =============================================================================
# Web Client ID (Web Apps, NextAuth & Verification Server Client ID)
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Mobile Apps Android Client IDs (Unique per App Package)
# Customer Mobile App: com.atlasbasket.customer
GOOGLE_CUSTOMER_ANDROID_CLIENT_ID=your_customer_android_client_id.apps.googleusercontent.com
# Seller Mobile App: com.atlasbasket.seller
GOOGLE_SELLER_ANDROID_CLIENT_ID=your_seller_android_client_id.apps.googleusercontent.com
# Delivery Partner Mobile App: com.atlasbasket.delivery
GOOGLE_DELIVERY_ANDROID_CLIENT_ID=your_delivery_android_client_id.apps.googleusercontent.com
# Default / Primary Android Client ID (aliases customer mobile app)
GOOGLE_ANDROID_CLIENT_ID=your_customer_android_client_id.apps.googleusercontent.com

# Mobile Apps iOS Client IDs
GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id.apps.googleusercontent.com
GOOGLE_CUSTOMER_IOS_CLIENT_ID=your_customer_ios_client_id.apps.googleusercontent.com
GOOGLE_SELLER_IOS_CLIENT_ID=your_seller_ios_client_id.apps.googleusercontent.com
GOOGLE_DELIVERY_IOS_CLIENT_ID=your_delivery_ios_client_id.apps.googleusercontent.com

# =============================================================================
# Frontend Application URLs & CORS
# =============================================================================
CUSTOMER_FRONTEND_URL=http://localhost:3000
SELLER_FRONTEND_URL=http://localhost:3002
ADMIN_FRONTEND_URL=http://localhost:3003
DELIVERY_FRONTEND_URL=http://localhost:8004

FRONTEND_CUSTOMER_URL=http://localhost:3000
FRONTEND_SELLER_URL=http://localhost:3002
FRONTEND_ADMIN_URL=http://localhost:3003
FRONTEND_DELIVERY_URL=http://localhost:8004

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:8001,http://localhost:8004,http://localhost:5173

# =============================================================================
# Payment Gateways (Razorpay & PhonePe)
# =============================================================================
PAYMENT_GATEWAY=RAZORPAY
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Optional PhonePe Configuration
PHONEPE_MERCHANT_ID=your_phonepe_merchant_id
PHONEPE_SALT_KEY=your_phonepe_salt_key
PHONEPE_SALT_INDEX=1
PHONEPE_HOST_URL=https://api-preprod.phonepe.com/apis/hermes
PHONEPE_MOCK=false
PAYMENT_CALLBACK_URL=http://localhost:3000/payment-callback
PAYMENT_REFUND_CALLBACK_URL=http://localhost:3000/refund-callback

# =============================================================================
# Delivery Provider & Logistics
# =============================================================================
DELIVERY_PROVIDER=INTERNAL
PORTER_API_KEY=your_porter_api_key
PORTER_API_URL=https://api.porter.in
PORTER_WEBHOOK_SECRET=your_porter_webhook_secret
DELIVERY_WEBHOOK_SECRET=your_delivery_webhook_secret
PORTER_REQUEST_TIMEOUT_MS=10000
PORTER_CIRCUIT_THRESHOLD=5
PORTER_CIRCUIT_TIMEOUT_MS=30000

# =============================================================================
# Google Maps Service (Geocoding & Polyline Routing)
# =============================================================================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_MAPS_SERVER_API_KEY=your_google_maps_server_api_key

# =============================================================================
# Storage (Cloudinary & S3)
# =============================================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://key:secret@cloud_name

# Optional AWS S3 Storage
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# S3_BUCKET_NAME=

# =============================================================================
# Email Service (Resend)
# =============================================================================
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=support@atlasbasket.com
APP_NAME=AtlasBasket

# =============================================================================
# Taxes & Platform Fee Settings
# =============================================================================
GST_PERCENTAGE=18
