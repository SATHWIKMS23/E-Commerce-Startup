# Stage 1: Build
FROM node:22-alpine AS builder
WORKDIR /app
# Prisma requires these env vars to be DEFINED during `prisma generate`
# (values are not used — generate does not connect). Real values come from the
# orchestration layer at runtime.
ENV DATABASE_URL=postgresql://placeholder:placeholder@localhost:5432/placeholder?schema=public
ENV DIRECT_URL=postgresql://placeholder:placeholder@localhost:5432/placeholder?schema=public
COPY package*.json tsconfig.json ./
COPY prisma ./prisma/
RUN --mount=type=cache,target=/root/.npm npm ci --maxsockets=1 --no-audit --fetch-retries=5 --fetch-retry-mintimeout=20000 --fetch-retry-maxtimeout=120000 --fetch-timeout=600000
COPY src ./src
COPY *.ts ./
RUN npx prisma generate
RUN npm run build

# Stage 2: Runtime
FROM node:22-alpine
WORKDIR /app
ENV DATABASE_URL=postgresql://placeholder:placeholder@localhost:5432/placeholder?schema=public
ENV DIRECT_URL=postgresql://placeholder:placeholder@localhost:5432/placeholder?schema=public
COPY package*.json ./
COPY prisma ./prisma/
COPY --from=builder /app/dist ./dist
RUN --mount=type=cache,target=/root/.npm npm ci --only=production --maxsockets=1 --no-audit --fetch-retries=5 --fetch-retry-mintimeout=20000 --fetch-retry-maxtimeout=120000 --fetch-timeout=600000
RUN npx prisma generate

ENV NODE_ENV=production
RUN mkdir -p /app/uploads/temp && chown -R node:node /app/uploads
USER node
EXPOSE 3004
CMD ["sh", "-c", "node dist/delivery.server.js"]
